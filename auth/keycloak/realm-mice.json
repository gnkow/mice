{
  "realm": "mice",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "clients": [
    {
      "clientId": "mice-auth",
      "name": "Mice Auth BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mice-auth-secret",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://auth:8080/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "http://localhost:5173/login##http://127.0.0.1:5173/login##http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false
    }
  ],
  "groups": [
    {
      "name": "engineering",
      "path": "/engineering"
    }
  ],
  "users": [
    {
      "username": "mice",
      "enabled": true,
      "email": "mice@example.com",
      "emailVerified": true,
      "firstName": "Mice",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "mice",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-mice-auth",
      "enabled": true,
      "serviceAccountClientId": "mice-auth",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "view-groups",
          "query-groups"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "partner-saml",
      "displayName": "Partner (SAML)",
      "providerId": "saml",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "entityId": "http://localhost:8180/realms/mice",
        "singleSignOnServiceUrl": "http://localhost:8180/realms/partner-saml/protocol/saml",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
        "principalType": "SUBJECT",
        "postBindingResponse": "true",
        "postBindingAuthnRequest": "true",
        "validateSignature": "false",
        "wantAssertionsSigned": "false",
        "wantAuthnRequestsSigned": "false",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "firstName",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "partner-saml",
      "identityProviderMapper": "saml-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "lastName",
        "user.attribute": "lastName"
      }
    }
  ]
}
