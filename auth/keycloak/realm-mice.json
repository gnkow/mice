{
  "realm": "mice",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "clients": [
    {
      "clientId": "mice-auth",
      "name": "Mice Auth BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mice-auth-secret",
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login##http://127.0.0.1:5173/login##http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true
    }
  ],
  "groups": [
    {
      "name": "engineering",
      "path": "/engineering"
    }
  ],
  "users": [
    {
      "username": "mice",
      "enabled": true,
      "email": "mice@example.com",
      "emailVerified": true,
      "firstName": "Mice",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "mice",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-mice-auth",
      "enabled": true,
      "serviceAccountClientId": "mice-auth",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "view-groups",
          "query-groups"
        ]
      }
    }
  ]
}
