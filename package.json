{
  "name": "boxen",
  "private": true,
  "type": "module",
  "description": "Open-source UI for Oxen (oxen-server)",
  "bin": {
    "boxen": "./cli/boxen.mjs"
  },
  "scripts": {
    "boxen": "node cli/boxen.mjs",
    "test": "playwright test -c e2e/playwright.config.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:unit": "npm run test:unit:cli && npm run test:unit:auth",
    "test:unit:cli": "node scripts/test-fail-fast.mjs cli/lib/oxen.test.mjs",
    "test:unit:auth": "node scripts/test-fail-fast.mjs --tsx auth/src/authz.test.ts auth/src/directory.test.ts auth/src/lineage.test.ts auth/src/jobs.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jose": "^6.1.0"
  }
}
