{
  "name": "boxen",
  "private": true,
  "type": "module",
  "description": "Open-source UI for Oxen (oxen-server)",
  "bin": {
    "boxen": "./cli/boxen.mjs"
  },
  "scripts": {
    "boxen": "node cli/boxen.mjs",
