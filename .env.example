# Host port for oxen-server (e2e helpers only; browsers use the BFF)
OXEN_PORT=3001

# Host port for the Mice web UI
WEB_PORT=5173

# Host port for the auth BFF
AUTH_PORT=8080

# Host port for Keycloak (OIDC) — omit / override when using another IdP
KEYCLOAK_PORT=8180

# Signed session cookie secret (change in any shared environment)
SESSION_SECRET=dev-only-change-me-mice-session-secret

# --- OIDC (required) ---
# Compose wires Keycloak by default. For another IdP, set these on the `auth`
# service (see README → “Use another OIDC IdP”) and stop/omit the keycloak service.
# OIDC_ISSUER=https://login.example.com/realms/mice
# OIDC_ISSUER_PUBLIC=https://login.example.com/realms/mice
# OIDC_CLIENT_ID=mice-auth
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# After IdP end-session, browser returns here (must match client allow-list)
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
# Id token claim for IdP groups (string or string[]; used for group AuthZ)
# OIDC_GROUPS_CLAIM=groups

# Public oxen remote for CLI (auth BFF). Clone box + /auth/cli-info use this.
# PUBLIC_OXEN_REMOTE=http://localhost:8080
# Browser UI origin for mice login device verification links (defaults from OIDC_REDIRECT_URI)
# PUBLIC_WEB_ORIGIN=http://localhost:5173
# Workspace disk (checkouts, leases, job and session work directories); every other store is a database.
# AUTH_DATA_DIR=/data

# PostgreSQL (main data) and immudb (audit trail) run as containers. Dev: `make db-secrets` writes passwords to
# .secrets/ (postgres-password, immudb-password, immudb.env). Production: provide the same files from your secret manager.
# Host ports are bound to 127.0.0.1 by compose.override.yaml so unit tests use the same databases as the BFF.
# POSTGRES_PORT=5432
# IMMUDB_PORT=3322
# POSTGRES_PASSWORD_PATH=./.secrets/postgres-password
# IMMUDB_PASSWORD_PATH=./.secrets/immudb-password
# IMMUDB_ENV_PATH=./.secrets/immudb.env

# The audit trail lives in immudb; its proofs replace the old signed checkpoints. Optional overrides:
# IMMUDB_HOST=127.0.0.1
# IMMUDB_DATABASE=audit
# Minimum characters of a change reason / commit message used as one
# AUDIT_REASON_MIN_LENGTH=10

# Notifications run on Novu (containers). Dev: `make db-secrets` writes .secrets/novu.env and .secrets/novu-password.
# NOVU_URL=http://127.0.0.1:3010
# NOVU_EMAIL=mice-bff@mice.local
# NOVU_PASSWORD_FILE=.secrets/novu-password

# PLAT-JOB (local Docker runner; Compose mounts the host Docker socket)
# JOBS_DATA_DIR=/data/jobs
# Absolute host path for job workdirs (make up/reset sets this to $(CURDIR)/.data/jobs).
# Required on Docker Desktop so runner containers can bind-mount the workdir.
# JOBS_HOST_DATA_DIR=/absolute/path/to/mice/.data/jobs
# JOBS_RUNNER=docker          # Local (Docker on auth host). Use kubernetes for Cluster.

# JOBS_IMAGE_PULL_ALLOWLIST=
# JOBS_MAX_CONCURRENT=2
# JOBS_DEFAULT_TIMEOUT_SEC=3600

# PLAT-AUTHO (AuthZ)
# AUTHZ_ENFORCE=true
# AUTHZ_BOOTSTRAP_ADMINS=mice@example.com
# Grant instance admin to every authenticated user (local/e2e only)
AUTHZ_DEV_GRANT_ALL=true
# Instance permissions (admins get all): create_namespace, view_audit, view_lineage,
# manage_own_tokens, cli_device_approve, session_create, session_connect, session_admin
# AUTHZ_REQUIRE_TRAINING=false

# Directory search (Keycloak Admin API; Compose sets KEYCLOAK_ADMIN_URL automatically)
# DIRECTORY_PROVIDER=keycloak
# KEYCLOAK_ADMIN_URL=http://keycloak:8080
# KEYCLOAK_REALM=mice
# For non-Keycloak IdPs without a directory API, set DIRECTORY_PROVIDER=none
# (member pickers still search principals already known to AuthZ stores).
