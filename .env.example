# Host port for oxen-server (e2e helpers / break-glass)
OXEN_PORT=3001

# Host port for the Boxen web UI
WEB_PORT=5173

# Host port for the auth BFF
AUTH_PORT=8080

# Host port for Keycloak (OIDC)
KEYCLOAK_PORT=8180

# Signed session cookie secret (change in any shared environment)
SESSION_SECRET=dev-only-change-me-boxen-session-secret

# Enable POST /auth/dev-login for local + Playwright (disable in prod)
AUTH_DEV_MODE=true

# Bearer accepted by the BFF without a session (Settings Advanced / e2e P-03)
AUTH_BREAKGLASS_TOKEN=e2e-test-token

# Dev-login identity (author injection when using AUTH_DEV_MODE)
AUTH_DEV_NAME=Boxen Dev
AUTH_DEV_EMAIL=dev@boxen.local

# After IdP end-session, browser returns here (must match Keycloak client allow-list)
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# Public oxen remote for CLI (auth BFF). Clone box + /auth/cli-info use this.
# PUBLIC_OXEN_REMOTE=http://localhost:8080
# AUTH_DATA_DIR=/data
